-    option_names = {f"--{name}": name for name, _, _ in MATRIX_PARAMETERS}
-    index = 0
-    while index < len(argv):
-        token = argv[index]
-        option, separator, inline_value = token.partition("=")
-        name = option_names.get(option)
-        if name is None:
-            remaining.append(token)
-            index += 1
-            continue
-        if separator:
-            value = inline_value
-        else:
-            index += 1
-            if index >= len(argv):
