+def parse_csv_list(value, option):
+    if value is None:
+        return []
+    values = [item.strip() for item in value.split(",") if item.strip()]
+    if not values:
+        fail(f"{option} has no valid value")
+    return values
+
+
+def env_first(env, names):
+    for name in names:
+        if env.get(name):
+            return env[name]
+    return None
+
+
+def read_dsubrun_prefix(env):
+    raw_value = env.get("DFT_IDE_DSUBRUN_I", "").strip()
+    if not raw_value:
+        fail("DFT_IDE_DSUBRUN_I is required and must not be empty")
+    try:
+        return shlex.split(raw_value)
+    except ValueError as error:
+        fail(f"Invalid DFT_IDE_DSUBRUN_I: {error}")
+
+
+def pop_matrix_options(argv):
+    """Extract wrapper options while leaving ordinary dftv step arguments intact."""
+    remaining, selected = [], {}
+    option_names = {f"--{name}": name for name, _, _ in MATRIX_PARAMETERS}
+    index = 0
+    while index < len(argv):
+        token = argv[index]
+        option, separator, inline_value = token.partition("=")
+        name = option_names.get(option)
+        if name is None:
+            remaining.append(token)
+            index += 1
+            continue
+        if separator:
+            value = inline_value
+        else:
+            index += 1
+            if index >= len(argv):
+                fail(f"{option} requires a value")
+            value = argv[index]
+        selected[name] = parse_csv_list(value, option)
+        index += 1
+    return remaining, selected
+
+
+def resolve_history_folder(work_path, env):
+    history_id = env.get("DFT_IDE_HISTORY", "").strip()
+    if not history_id:
+        history_id = f"cli_{time.time_ns() // 1_000_000}_{secrets.randbelow(1000):03d}"
+        env["DFT_IDE_HISTORY"] = history_id
+    if history_id in (".", "..") or "/" in history_id or "\\" in history_id:
+        fail("DFT_IDE_HISTORY must be a folder name, not a path")
+    history_folder = (
+        work_path.parent
+        / ".dft-ide"
+        / "local-state"
+        / "history"
+        / "verification"
+        / history_id
+    )
+    history_folder.mkdir(parents=True, exist_ok=True)
+    return history_folder
+
+
+def build_submissions(explicit, env):
+    dimensions = []
+    for name, env_names, flag in MATRIX_PARAMETERS:
+        values = explicit.get(name)
+        if values is None:
+            raw_value = env_first(env, env_names)
+            values = parse_csv_list(raw_value, env_names[0]) if raw_value else []
+        if values:
+            dimensions.append((name, flag, values))
+    if not dimensions:
+        return [({}, {})]
+    return [
+        (
+            {item[0]: value for item, value in zip(dimensions, combination)},
+            {item[1]: value for item, value in zip(dimensions, combination)},
+        )
+        for combination in itertools.product(*(item[2] for item in dimensions))
+    ]
+
+
+def read_max_concurrency(env):
+    raw_value = env.get("DFT_IDE_MAX_CONCURRENCY", str(DEFAULT_MAX_CONCURRENCY))
+    try:
+        value = int(raw_value)
+    except ValueError:
+        fail("DFT_IDE_MAX_CONCURRENCY must be a positive integer")
+    if value < 1:
+        fail("DFT_IDE_MAX_CONCURRENCY must be greater than 0")
+    return value
