-async def run_submissions(step, submissions, make_lines, runtime_env, max_concurrency):
-    semaphore = asyncio.Semaphore(min(max_concurrency, len(submissions)))
-
-    async def run_one(worker_id, labels, parameters):
-        async with semaphore:
-            rendered = ", ".join(f"{key}={value}" for key, value in labels.items()) or "default"
-            output_prefix = f"{step}-{worker_id:03d}"
-            print(f"[HiSalad] Worker {worker_id:03d} started: {rendered}", flush=True)
-            status = await asyncio.to_thread(
-                run_csh,
-                make_lines(labels, parameters),
-                runtime_env,
-                output_prefix,
-            )
-            print(f"[HiSalad] Worker {worker_id:03d} finished: status={status}", flush=True)
-            return status
-
-    return await asyncio.gather(*(
-        run_one(worker_id, labels, parameters)
-        for worker_id, (labels, parameters) in enumerate(submissions, start=1)
-    ))
