-_CONSOLE_OUTPUT_LOCK = threading.Lock()
-_CONSOLE_LINE_ENDING = "\r\n" if sys.stdout.isatty() else "\n"
-
-
-def write_console_line(line, output_prefix=None):
-    output = line.rstrip("\r\n")
-    if output_prefix:
-        output = f"[{output_prefix}] {output}"
-    with _CONSOLE_OUTPUT_LOCK:
-        sys.stdout.write(output + _CONSOLE_LINE_ENDING)
-        sys.stdout.flush()
-
-def run_csh(lines, env, output_prefix=None):
-    script_path = None
-    try:
-        with tempfile.NamedTemporaryFile("w", suffix=".csh", encoding="utf-8", newline="\n", delete=False) as handle:
-            handle.write("#!/bin/csh\n")
-            handle.write("\n".join(lines))
-            handle.write("\n")
-            script_path = handle.name
-        process = subprocess.Popen(
-            ["/bin/csh", script_path],
-            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
-            text=True, encoding=env.get("DFT_IDE_OUTPUT_ENCODING", "utf-8"),
-            errors="replace", env=env,
-        )
-        assert process.stdout is not None
-        for line in process.stdout:
-            write_console_line(line, output_prefix)
-        return process.wait()
-    except FileNotFoundError:
-        fail("找不到 Csh 可执行程序: /bin/csh", 127)
-    finally:
-        if script_path:
-            try:
-                Path(script_path).unlink()
-            except OSError:
-                pass
-
