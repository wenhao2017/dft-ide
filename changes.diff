+    return candidate
+  }
+
+  let index = 1
+  while (
+    findItem.versions.some(
+      (version) => version.trim().toLowerCase() === candidate.toLowerCase(),
+    )
+  ) {
+    index += 1
+
+    candidate = `V${index}`
